.0                       3280.62            0.5          0.5                 12\n","1        LightGBM Regressor [Walk-Forward]               3110.29                   211.03                       -1.26                         100.0                 3923.55                     292.36                         -5.02                           100.0                       4013.12            0.5          0.5                 12\n","2  LightGBM Regressor [Tuned Walk-Forward]               1925.82                    92.58                       -2.67                         100.0                 1929.84                      92.98                        -17.40                            99.4                       2009.59            0.5          0.5                 12\n","3               LightGBM Regressor [Tuned]               1703.45                    70.34                       -3.84                         100.0                 1314.87                      31.49                        -20.92                            88.0                       1375.70            0.5          0.5                 12"]},"metadata":{},"output_type":"display_data"},{"data":{"text/plain":["4273"]},"execution_count":17,"metadata":{},"output_type":"execute_result"}],"source":["val_mmc_df = val_diag_meta.assign(**{TARGET_COL: y_validation.to_numpy(dtype=np.float32)})\n","staking_basis_label = v6_contrib_info['basis_label']\n","staking_is_proxy = bool(v6_contrib_info['mmc_is_proxy'])\n","print(f\"Active Staking Basis: {staking_basis_label}\")\n","print(f\"  -> Reason: {v6_contrib_info['reason']}\")\n","\n","stake_pnl_by_variant = {}\n","variant_era_mmc_by_variant = {}\n","live_scenarios_by_variant = {}\n","staking_summary_rows = []\n","for variant_name in comparison_df['variant'].tolist():\n","    is_best_variant = (variant_name == best_variant_name)\n","    variant_slug = (\n","        variant_name.lower()\n","        .replace(' ', '_')\n","        .replace('(', '')\n","        .replace(')', '')\n","        .replace('[', '')\n","        .replace(']', '')\n","        .replace('-', '_')\n","    )\n","    variant_era_corrs = model_results[variant_name]['validation_era_corrs']\n","    variant_era_contrib = compute_per_era_mmc(\n","        val_mmc_df,\n","        model_results[variant_name]['validation_preds'],\n","        meta_model_path=v6_contrib_info['meta_model_path'],\n","        benchmark_path=v6_contrib_info['benchmark_path'],\n","        is_benchmark_proxy=staking_is_proxy,\n","        era_col=ERA_COL,\n","        target_col=TARGET_COL,\n","    )\n","    variant_era_mmc_by_variant[variant_name] = variant_era_contrib\n","\n","    live_scenarios_by_variant[variant_name] = simulate_live_staking_scenarios(\n","        variant_era_corrs,\n","        per_era_mmc=variant_era_contrib,\n","        mmc_is_proxy=staking_is_proxy,\n","        total_capital=1000.0,\n","        settlement_rounds=12,\n","        weekly_concurrent_rounds=12,\n","        conservative_payout_factor=0.5,\n","        live_payout_factor=0.5,\n","        bmc_proxy_haircut=0.5,\n","        n_sims=500,\n","        block_size=12,\n","        random_state=random_state,\n","        title=variant_name,\n","        era_dates=val_era_dates,\n","    )\n","\n","    title_label = f'[CV-LOCKED WINNER] {variant_name}' if is_best_variant else variant_name\n","    pnl_save_path = (\n","        results_dir / f'{timestamp}_{experiment_name}_{variant_slug}_stake_pnl_dashboard.png'\n","        if save_results\n","        else None\n","    )\n","    haircutted_contrib = (\n","        pd.Series(variant_era_contrib, dtype=np.float64) * (0.5 if staking_is_proxy else 1.0)\n","        if variant_era_contrib is not None\n","        else None\n","    )\n","    if haircutted_contrib is not None:\n","        haircutted_contrib.name = 'bmc_proxy' if staking_is_proxy else 'mmc'\n","    stake_pnl_by_variant[variant_name] = plot_stake_pnl_dashboard(\n","        variant_era_corrs,\n","        per_era_mmc=haircutted_contrib,\n","        mmc_is_proxy=staking_is_proxy,\n","        conservative_pnl=live_scenarios_by_variant[variant_name]['conservative_floor']['pnl'],\n","        title=f'{title_label} [Realistic Live vs Conservative Floor | PF=0.5, R=12]',\n","        total_capital=1000.0,\n","        concurrent_rounds=12,\n","        settlement_rounds=12,\n","        payout_factor=0.5,\n","        payout_rule='auto',\n","        staking_mode='compound',\n","        era_dates=val_era_dates,\n","        save_path=pnl_save_path,\n","    )\n","\n","    v_pnl = stake_pnl_by_variant[variant_name]\n","    c_pnl = live_scenarios_by_variant[variant_name]['conservative_floor']['pnl']\n","    mean_contrib = float(variant_era_contrib.mean()) if variant_era_contrib is not None and len(variant_era_contrib) > 0 else np.nan\n","    contrib_col_name = 'validation_bmc_proxy' if staking_is_proxy else 'validation_true_mmc'\n","    staking_summary_rows.append({\n","        'variant': variant_name,\n","        'staking_basis': v_pnl['score_basis'],\n","        'staking_mode': 'One-Wallet (Compounding, PF=0.5, R=12)',\n","        'validation_corr': round(float(variant_era_corrs.mean()), 4),\n","        contrib_col_name: round(mean_contrib, 4) if np.isfinite(mean_contrib) else np.nan,\n","        'start_capital': round(float(v_pnl['start_capital']), 2),\n","        'end_capital': round(float(v_pnl['end_capital']), 2),\n","        'total_return_pct': round(float(v_pnl['total_return_pct']), 2),\n","        'worst_dip_pct': round(float(v_pnl['money_drawdown_pct']), 2),\n","        'worst_dip_gbp': round(float(v_pnl['max_drawdown_gbp']), 2),\n","        'worst_round_gbp': round(float(v_pnl['worst_round_gbp']), 2),\n","    })\n","    print(\n","        f\"{title_label} | Realistic Live (PF=0.5, 0.5x BMC, R=12): £{v_pnl['end_capital']:,.2f} ({v_pnl['total_return_pct']:+.2f}%, Dip {v_pnl['money_drawdown_pct']:.2f}%) | \"\n","        f\"Conservative Floor (CORR only, PF=0.5, R=12): £{c_pnl['end_capital']:,.2f} ({c_pnl['total_return_pct']:+.2f}%, Dip {c_pnl['money_drawdown_pct']:.2f}%) | \"\n","        f\"Basis: {v_pnl['score_basis']}\"\n","    )\n","\n","staking_comparison_df = pd.DataFrame(staking_summary_rows)\n","live_staking_scenarios_df = build_live_staking_scenarios_df(live_scenarios_by_variant)\n","comparison_df['staking_basis'] = comparison_df['variant'].map(\n","    staking_comparison_df.set_index('variant')['staking_basis']\n",")\n","if staking_is_proxy:\n","    comparison_df['validation_bmc_proxy'] = comparison_df['variant'].map(\n","        staking_comparison_df.set_index('variant')['validation_bmc_proxy']\n","    )\n","elif v6_contrib_info['basis_kind'] == 'true_mmc':\n","    comparison_df['validation_true_mmc'] = comparison_df['variant'].map(\n","        staking_comparison_df.set_index('variant')['validation_true_mmc']\n","    )\n","display_compact_dataframe(\n","    live_staking_scenarios_df,\n","    title='Dual-Scenario Realistic Live Staking Table (Conservative Floor vs. Realistic Live):',\n",")\n","best_stake_pnl = stake_pnl_by_variant[best_variant_name]\n","del val_mmc_df, val_diag_meta\n","gc.collect()"]},{"cell_type":"markdown","id":"97a6b1f9","metadata":{"papermill":{"duration":0.020063,"end_time":"2026-11-26T01:55:20.259079+00:00","exception":false,"start_time":"2026-11-26T01:55:20.239016+00:00","status":"completed"},"tags":[]},"source":["### Monte Carlo Block-Bootstrap Risk Analysis (£)"]},{"cell_type":"code","execution_count":18,"id":"2fe45b0b","metadata":{"execution":{"iopub.execute_input":"2026-11-26T01:55:20.30116Z","iopub.status.busy":"2026-11-26T01:55:20.300052Z","iopub.status.idle":"2026-11-26T01:55:36.35009Z","shell.execute_reply":"2026-11-26T01:55:36.349151Z"},"papermill":{"duration":16.084048,"end_time":"2026-11-26T01:55:36.362447+00:00","exception":false,"start_time":"2026-11-26T01:55:20.278399+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1650x1140 with 3 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["====================================================================================================\n","LightGBM Regressor [Default] — VERDICT: Median path MAKES money. Median finish £3,280.62 from £1,000 start (+228.1%). 100.0% of 500 simulated paths finish above £1,000 (0.0% lose money).\n","\n","How to read Drawdown vs Final Balance (Plain English):\n","  • Drawdown is the biggest peak-to-trough dip DURING the journey — NOT your final profit or loss.\n","  • Worked example (Winning path with a drawdown): Start £1,000 -> rises to £1,200 peak -> dips to £1,100 (-8.3% drawdown from peak) -> recovers to £1,300. You still finish +£300 ABOVE £1,000 despite the dip.\n","  • Worked example (Losing path with a small drawdown): Start £1,000 -> drifts down to £955 (-4.5% dip) and ends at £984.81. A small drawdown still finishes BELOW £1,000 if it never recovers.\n","  • Median (50th) vs 95th percentile are DIFFERENT paths: Median = typical path; 95th = lucky top 5% of paths.\n","  • One-Wallet MC: Simulates ONE continuous wallet from start to finish over the full validation period with no resets.\n","  • Within-Window MC: Simulates separate, reset windows (e.g. rolling sub-period pots) — a different test that is never mixed with One-Wallet MC.\n","  • Sizing rule in this One-Wallet run: Compounding. Compounding resizes each round's stake as your wallet grows, so a path can climb very high, suffer a huge peak-to-trough drawdown (e.g. -91.8% from a high peak), and STILL finish above £1,000.\n","\n","LightGBM Regressor [Default] [Realistic Live: PF=0.5, 0.5x BMC, R=12] [One-Wallet MC | BMC proxy (benchmark, NOT true MMC) | Compounding] | P(Profit): 100.0% (0.0% lose) | Median (50th): £3,280.62 (+228.1%) | 5th Pct: £2,350.19 | 95th Pct: £4,324.29 | 95% Worst Dip: -7.11% | P(Ruin): 0.0%\n","  -> What drawdown means: 95% Worst Dip -7.11% means in 95% of paths the worst fall from peak was 7.11% or less — this is NOT the final loss.\n","  -> Conservative Floor MC (CORR only, PF=0.5, R=12): P(Profit)=100.0% | Median=£2,917.26 | 95% Worst Dip=-0.71%\n","====================================================================================================\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1650x1140 with 3 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["====================================================================================================\n","LightGBM Regressor [Walk-Forward] — VERDICT: Median path MAKES money. Median finish £4,013.12 from £1,000 start (+301.3%). 100.0% of 500 simulated paths finish above £1,000 (0.0% lose money).\n","\n","LightGBM Regressor [Walk-Forward] [Realistic Live: PF=0.5, 0.5x BMC, R=12] [One-Wallet MC | BMC proxy (benchmark, NOT true MMC) | Compounding] | P(Profit): 100.0% (0.0% lose) | Median (50th): £4,013.12 (+301.3%) | 5th Pct: £2,830.81 | 95th Pct: £5,710.39 | 95% Worst Dip: -7.99% | P(Ruin): 0.0%\n","  -> What drawdown means: 95% Worst Dip -7.99% means in 95% of paths the worst fall from peak was 7.99% or less — this is NOT the final loss.\n","  -> Conservative Floor MC (CORR only, PF=0.5, R=12): P(Profit)=100.0% | Median=£3,157.69 | 95% Worst Dip=-1.27%\n","====================================================================================================\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1650x1140 with 3 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["====================================================================================================\n","LightGBM Regressor [Tuned Walk-Forward] — VERDICT: Median path MAKES money. Median finish £2,009.59 from £1,000 start (+101.0%). 99.4% of 500 simulated paths finish above £1,000 (0.6% lose money).\n","\n","LightGBM Regressor [Tuned Walk-Forward] [Realistic Live: PF=0.5, 0.5x BMC, R=12] [One-Wallet MC | BMC proxy (benchmark, NOT true MMC) | Compounding] | P(Profit): 99.4% (0.6% lose) | Median (50th): £2,009.59 (+101.0%) | 5th Pct: £1,262.02 | 95th Pct: £2,880.06 | 95% Worst Dip: -18.88% | P(Ruin): 0.0%\n","  -> What drawdown means: 95% Worst Dip -18.88% means in 95% of paths the worst fall from peak was 18.88% or less — this is NOT the final loss.\n","  -> Conservative Floor MC (CORR only, PF=0.5, R=12): P(Profit)=100.0% | Median=£1,952.04 | 95% Worst Dip=-2.50%\n","====================================================================================================\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1650x1140 with 3 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["====================================================================================================\n","[CV-LOCKED WINNER] LightGBM Regressor [Tuned] — VERDICT: Median path MAKES money. Median finish £1,375.70 from £1,000 start (+37.6%). 88.0% of 500 simulated paths finish above £1,000 (12.0% lose money).\n","\n","[CV-LOCKED WINNER] LightGBM Regressor [Tuned] [Realistic Live: PF=0.5, 0.5x BMC, R=12] [One-Wallet MC | BMC proxy (benchmark, NOT true MMC) | Compounding] | P(Profit): 88.0% (12.0% lose) | Median (50th): £1,375.70 (+37.6%) | 5th Pct: £845.77 | 95th Pct: £1,976.71 | 95% Worst Dip: -30.30% | P(Ruin): 0.0%\n","  -> What drawdown means: 95% Worst Dip -30.30% means in 95% of paths the worst fall from peak was 30.30% or less — this is NOT the final loss.\n","  -> Conservative Floor MC (CORR only, PF=0.5, R=12): P(Profit)=100.0% | Median=£1,729.36 | 95% Worst Dip=-4.25%\n","====================================================================================================\n"]},{"data":{"text/plain":["46409"]},"execution_count":18,"metadata":{},"output_type":"execute_result"}],"source":["mc_risk_by_variant = {}\n","explainer_printed = False\n","staking_is_proxy = bool(v6_contrib_info['mmc_is_proxy'])\n","for variant_name in comparison_df['variant'].tolist():\n","    is_best_variant = (variant_name == best_variant_name)\n","    variant_slug = (\n","        variant_name.lower()\n","        .replace(' ', '_')\n","        .replace('(', '')\n","        .replace(')', '')\n","        .replace('[', '')\n","        .replace(']', '')\n","        .replace('-', '_')\n","    )\n","    mc_save_path = (\n","        results_dir / f'{timestamp}_{experiment_name}_{variant_slug}_monte_carlo_pnl.png'\n","        if save_results\n","        else None\n","    )\n","    title_label = f'[CV-LOCKED WINNER] {variant_name}' if is_best_variant else variant_name\n","    raw_contrib = variant_era_mmc_by_variant.get(variant_name)\n","    haircutted_contrib = (\n","        pd.Series(raw_contrib, dtype=np.float64) * (0.5 if staking_is_proxy else 1.0)\n","        if raw_contrib is not None\n","        else None\n","    )\n","    if haircutted_contrib is not None:\n","        haircutted_contrib.name = 'bmc_proxy' if staking_is_proxy else 'mmc'\n","    v_mc = plot_stake_pnl_monte_carlo(\n","        model_results[variant_name]['validation_era_corrs'],\n","        per_era_mmc=haircutted_contrib,\n","        mmc_is_proxy=staking_is_proxy,\n","        title=f'{title_label} [Realistic Live: PF=0.5, 0.5x BMC, R=12]',\n","        total_capital=1000.0,\n","        concurrent_rounds=12,\n","        settlement_rounds=12,\n","        payout_factor=0.5,\n","        payout_rule='auto',\n","        staking_mode='compound',\n","        n_sims=500,\n","        block_size=12,\n","        random_state=random_state,\n","        era_dates=val_era_dates,\n","        save_path=mc_save_path,\n","        retain_paths=False,\n","    )\n","    mc_risk_by_variant[variant_name] = v_mc\n","    c_mc = live_scenarios_by_variant[variant_name]['conservative_floor']['mc']\n","    print('=' * 100)\n","    print(f\"{title_label} — {v_mc['mc_verdict_text']}\")\n","    if not explainer_printed:\n","        print()\n","        print(v_mc['mc_explainer_text'])\n","        explainer_printed = True\n","    print()\n","    print(v_mc['mc_summary_line'])\n","    print(f\"  -> {v_mc['mc_drawdown_explanation_line']}\")\n","    print(\n","        f\"  -> Conservative Floor MC (CORR only, PF=0.5, R=12): P(Profit)={c_mc['mc_prob_profit_pct']:.1f}% | \"\n","        f\"Median=£{c_mc['mc_median_final_stake']:,.2f} | 95% Worst Dip={c_mc['mc_p95_money_drawdown_pct']:.2f}%\"\n","    )\n","    print('=' * 100)\n","gc.collect()"]},{"cell_type":"markdown","id":"028f2f47","metadata":{"papermill":{"duration":0.04429,"end_time":"2026-11-26T01:55:36.454541+00:00","exception":false,"start_time":"2026-11-26T01:55:36.410251+00:00","status":"completed"},"tags":[]},"source":["### Cumulative & Rolling 20-Era Validation CORR"]},{"cell_type":"code","execution_count":19,"id":"291cba56","metadata":{"execution":{"iopub.execute_input":"2026-11-26T01:55:36.539168Z","iopub.status.busy":"2026-11-26T01:55:36.53876Z","iopub.status.idle":"2026-11-26T01:55:37.501207Z","shell.execute_reply":"2026-11-26T01:55:37.499995Z"},"papermill":{"duration":1.009718,"end_time":"2026-11-26T01:55:37.505235+00:00","exception":false,"start_time":"2026-11-26T01:55:36.495517+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1450x520 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 1450x540 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["cum_corr_save_path = (\n","    results_dir / f'{timestamp}_{experiment_name}_cumulative_validation_corr.png'\n","    if save_results\n","    else None\n",")\n","cumulative_corr_df = plot_cumulative_validation_corr(\n","    model_results,\n","    best_variant_name=best_variant_name,\n","    title='Cumulative Validation CORR Across LightGBM Variants',\n","    save_path=cum_corr_save_path,\n",")\n","\n","secondary_era_corrs = {\n","    v_name: v_res['validation_era_corrs']\n","    for v_name, v_res in model_results.items()\n","    if v_n