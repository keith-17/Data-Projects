    "        lgbm_param_space\n",
    "        if isinstance(lgbm_param_space, list)\n",
    "        else build_conditional_bayesian_spaces(lgbm_param_space, total_n_iter=n_iter)\n",
    "    )\n",
    "    search = BayesSearchCV(\n",
    "        estimator=lgbm_pipeline,\n",
    "        search_spaces=model_search_spaces,\n",
    "        n_iter=n_iter,\n",
    "        optimizer_kwargs={'base_estimator': 'ET', 'acq_func': 'EI', 'n_initial_points': min(4, max(1, n_iter // 3))},\n",
    "        scoring=cv_scorer,\n",
    "        cv=cv_object,\n",
    "        refit=False,\n",
    "        random_state=random_state,\n",
    "        verbose=verbose,\n",
    "        error_score=error_score,\n",
    "        n_jobs=1,\n",
    "    )\n",
    "else:\n",
    "    deduped_grid = deduplicate_param_grid(lgbm_param_space, base_params=lgbm_pipeline.get_params(deep=True))\n",
    "    search = GridSearchCV(\n",
    "        estimator=lgbm_pipeline,\n",
    "        param_grid=deduped_grid,\n",
    "        scoring=cv_scorer,\n",
    "        cv=cv_object,\n",
    "        refit=False,\n",
    "        verbose=verbose,\n",
    "        error_score=error_score,\n",
    "        n_jobs=1,\n",
    "    )\n",
    "\n",
    "reset_cv_metric_log()\n",
    "search.fit(X_train, y_train, groups=train_eras)\n",
    "cv_results_df = build_quick_results_df(search)\n",
    "cv_results_by_model[model_name] = cv_results_df\n",
    "trials_matrix = cv_results_df.attrs.get('trials_era_corrs_df')\n",
    "pbo_info = compute_pbo_cscv(trials_matrix, random_state=random_state) if trials_matrix is not None else {'pbo': float(np.nan)}\n",
    "effective_ver = (\n",
    "    str(cv_results_df.loc[0, 'score_version'])\n",
    "    if ('score_version' in cv_results_df.columns and len(cv_results_df) > 0)\n",
    "    else str(score_version)\n",
    ")\n",
    "best_params = dict(search.best_params_)\n",
    "search_summary_rows.append({\n",
    "    'model': model_name,\n",
    "    'search_mode': search_mode,\n",
    "    'score_version': effective_ver,\n",
    "    'best_cv_score': float(search.best_score_),\n",
    "    'best_cv_corr': float(cv_results_df.loc[0, 'mean_numerai_corr'])\n",
    "    if ('mean_numerai_corr' in cv_results_df.columns and len(cv_results_df) > 0)\n",
    "    else float(search.best_score_),\n",
    "    'best_cv_corr_pct': round(float(search.best_score_) * 100.0, 2),\n",
    "    'pbo_cscv': round(float(pbo_info['pbo']), 4) if np.isfinite(pbo_info['pbo']) else float(np.nan),\n",
    "    'best_params': best_params,\n",
    "})\n",
    "\n",
    "tuned_pipeline = prepare_tuned_pipeline(lgbm_pipeline, best_params)\n",
    "tuned_model = clone(tuned_pipeline).fit(X_train_static, y_train_static)\n",
    "tuned_params = dict(tuned_model.named_steps['estimator'].get_params())\n",
    "tuned_train_preds = tuned_model.predict(X_train_static)\n",
    "tuned_train_eval = evaluate_numerai_predictions(\n",
    "    y_train_static,\n",
    "    tuned_train_preds,\n",
    "    eras=train_eras_static,\n",
    "    features_df=X_train_static,\n",
    "    feature_columns=feature_columns,\n",
    "    label=f'{model_name} [Tuned] — Final Training Scores',\n",
    "    verbose=True,\n",
    ")\n",
    "trial_srs = (\n",
    "    cv_results_df['mean_sharpe'].dropna().to_numpy(dtype=np.float64)\n",
    "    if ('mean_sharpe' in cv_results_df.columns and len(cv_results_df) > 0)\n",
    "    else None\n",
    ")\n",
    "\n",
    "# Infer causal lookback eras automatically from fitted pipeline (no extra knobs)\n",
    "_mr_seq = max(int(default_params.get('seq_len', 1) or 1), int(tuned_params.get('seq_len', 1) or 1))\n",
    "_mr_stride = int(era_stride) if str(era_stride).isdigit() else int(target_horizon_eras)\n",
    "_ext_lookback = 16\n",
    "for _p_dict in (default_params, tuned_params):\n",
    "    for _k in ('extractor__rolling_era_windows', 'extractor__ticker_windows', 'extractor__era_lag_scales', 'extractor__ticker_lag_steps'):\n",
    "        _v = _p_dict.get(_k)\n",
    "        if isinstance(_v, (list, tuple)) and _v:\n",
    "            _ext_lookback = max(_ext_lookback, max(int(x) for x in _v))\n",
    "lookback_eras = max(_ext_lookback, (_mr_seq - 1) * _mr_stride) if _mr_seq > 1 else _ext_lookback\n",
    "\n",
    "val_input_columns = list(X_train.columns)\n",
    "\n",
    "# Free all training data before loading validation chunks\n",
    "del X_train, y_train, train_eras, X_train_static, y_train_static, train_eras_static, tuned_train_preds, search\n",
    "clear_extraction_cache()\n",
    "gc.collect()\n",
    "\n",
    "# =====================================================================\n",
    "# HALF 2: 52-Era Chunked Validation & Parallel Walk-Forward\n",
    "# =====================================================================\n",
    "all_val_eras = sorted([int(e) for e in feature_metadata.get('val_eras', [])])\n",
    "if not all_val_eras:\n",
    "    _, _tmp_val, _, _ = load_unity_numerai_data_cached(\n",
    "        data_version=data_version, data_folder=data_folder, kaggle_dataset=kaggle_dataset,\n",
    "        feature_set=feature_set, target_col=TARGET_COL, era_stride=era_stride,\n",
    "        downsample_mode=downsample_mode, downsample_frac=downsample_frac,\n",
    "        val_downsample_mode=val_downsample_mode, val_downsample_frac=val_downsample_frac,\n",
    "        random_state=random_state, ticker_timeseries_features=ticker_timeseries_features,\n",
    "        ticker_rolling_windows=ticker_rolling_windows, ticker_lag_steps=ticker_lag_steps,\n",
    "        workspace_root=workspace_root, auto_download=True, use_numerapi_fallback=True,\n",
    "        force_reload=False, split='validation',\n",
    "    )\n",
    "    all_val_eras = sorted([int(e) for e in _tmp_val[ERA_COL].unique()])\n",
    "    del _tmp_val\n",
    "    gc.collect()\n",
    "\n",
    "_chunk_step = max(1, int(walk_forward_step_eras))\n",
    "val_era_chunks = [all_val_eras[i : i + _chunk_step] for i in range(0, len(all_val_eras), _chunk_step)]\n",
    "print(f'Evaluating validation in {len(val_era_chunks)} chunk(s) of up to {_chunk_step} eras (lookback={lookback_eras} eras)')\n",
    "\n",
    "_y_val_parts, _era_val_parts, _meta_val_parts = [], [], []\n",
    "_def_pred_parts, _tun_pred_parts = [], []\n",
    "_def_fexp_vals, _tun_fexp_vals = [], []\n",
    "_chunk_weights = []\n",
    "\n",
    "from concurrent.futures import ThreadPoolExecutor as _ChunkPool\n",
    "\n",
    "def _load_val_chunk_sync(eras_to_load):\n",
    "    return load_unity_numerai_data_cached(\n",
    "        data_version=data_version,\n",
    "        data_folder=data_folder,\n",
    "        kaggle_dataset=kaggle_dataset,\n",
    "        feature_set=feature_set,\n",
    "        target_col=TARGET_COL,\n",
    "        era_stride=era_stride,\n",
    "        downsample_mode=downsample_mode,\n",
    "        downsample_frac=downsample_frac,\n",
    "        val_downsample_mode=val_downsample_mode,\n",
    "        val_downsample_frac=val_downsample_frac,\n",
    "        random_state=random_state,\n",
    "        ticker_timeseries_features=ticker_timeseries_features,\n",
    "        ticker_rolling_windows=ticker_rolling_windows,\n",
    "        ticker_lag_steps=ticker_lag_steps,\n",
    "        workspace_root=workspace_root,\n",
    "        auto_download=True,\n",
    "        use_numerapi_fallback=True,\n",
    "        force_reload=False,\n",
    "        split='validation',\n",
    "        val_era_subset=eras_to_load,\n",
    "    )[1]\n",
    "\n",
    "with _ChunkPool(max_workers=1) as _prefetch_pool:\n",
    "    _next_future = None\n",
    "    if val_era_chunks:\n",
    "        _first_c = val_era_chunks[0]\n",
    "        _first_pre = [e for e in all_val_eras if (_first_c[0] - lookback_eras) <= e < _first_c[0]]\n",
    "        _next_future = _prefetch_pool.submit(_load_val_chunk_sync, _first_pre + _first_c)\n",
    "    for _c_idx, _c_eras in enumerate(val_era_chunks, 1):\n",
    "        _chunk_df = _next_future.result()\n",
    "        if _c_idx < len(val_era_chunks):\n",
    "            _nxt_c = val_era_chunks[_c_idx]\n",
    "            _nxt_pre = [e for e in all_val_eras if (_nxt_c[0] - lookback_eras) <= e < _nxt_c[0]]\n",
    "            _next_future = _prefetch_pool.submit(_load_val_chunk_sync, _nxt_pre + _nxt_c)\n",
    "        else:\n",
    "            _next_future = None\n",
    "        _X_all = _chunk_df[[c for c in val_input_columns if c in _chunk_df.columns]].reset_index(drop=True)\n",
    "        _e_all = _chunk_df[ERA_COL].astype(np.int32).reset_index(drop=True)\n",
    "        _keep_mask = _e_all.isin(_c_eras).to_numpy()\n",
    "        _X_keep = _X_all.loc[_keep_mask].reset_index(drop=True)\n",
    "        _y_keep = _chunk_df.loc[_keep_mask, TARGET_COL].astype(np.float32).reset_index(drop=True)\n",
    "        _e_keep = _e_all.loc[_keep_mask].reset_index(drop=True)\n",
    "        _meta_keep = _chunk_df.loc[_keep_mask, [c for c in ('id', 'numerai_ticker', 'date', ERA_COL) if c in _chunk_df.columns]].reset_index(drop=True).copy()\n",
    "\n",
    "        _def_p = np.asarray(default_model.predict(_X_all), dtype=np.float64)[_keep_mask]\n",
    "        _tun_p = np.asarray(tuned_model.predict(_X_all), dtype=np.float64)[_keep_mask]\n",
    "\n",
    "        _def_fexp = evaluate_numerai_predictions(_y_keep, _def_p, eras=_e_keep, features_df=_X_keep, feature_columns=feature_columns, verbose=False)['feature_exposure']\n",
    "        _tun_fexp = evaluate_numerai_predictions(_y_keep, _tun_p, eras=_e_keep, features_df=_X_keep, feature_columns=feature_columns, verbose=False)['feature_exposure']\n",
    "\n",
    "        _y_val_parts.append(_y_keep)\n",
    "        _era_val_parts.append(_e_keep)\n",
    "        _meta_val_parts.append(_meta_keep)\n",
    "        _def_pred_parts.append(_def_p)\n",
    "        _tun_pred_parts.append(_tun_p)\n",
    "        _def_fexp_vals.append(float(_def_fexp))\n",
    "        _tun_fexp_vals.append(float(_tun_fexp))\n",
    "        _chunk_weights.append(len(_c_eras))\n",
    "\n",
    "        del _chunk_df, _X_all, _X_keep, _e_all\n",
    "        gc.collect()\n",
    "\n",
    "y_validation = pd.concat(_y_val_parts, axis=0, ignore_index=True)\n",
    "validation_eras = pd.concat(_era_val_parts, axis=0, ignore_index=True)\n",
    "val_diag_meta = pd.concat(_meta_val_parts, axis=0, ignore_index=True)\n",
    "val_era_dates = (\n",
    "    val_diag_meta.groupby(ERA_COL, sort=True)['date'].first()\n",
    "    if ('date' in val_diag_meta.columns and ERA_COL in val_diag_meta.columns)\n",
    "    else None\n",
    ")\n",
    "val_preds = np.concatenate(_def_pred_parts)\n",
    "tuned_val_preds = np.concatenate(_tun_pred_parts)\n",
    "del _y_val_parts, _era_val_parts, _meta_val_parts, _def_pred_parts, _tun_pred_parts, default_model, tuned_model\n",
    "gc.collect()\n",
    "\n",
    "val_eval = evaluate_numerai_predictions(\n",
    "    y_validation,\n",
    "    val_preds,\n",
    "    eras=validation_eras,\n",
    "    features_df=None,\n",
    "    feature_columns=feature_columns,\n",
    "    label=f'{model_name} — Final Validation Scores',\n",
    "    verbose=True,\n",
    ")\n",
    "val_eval['feature_exposure'] = round(float(np.average(_def_fexp_vals, weights=_chunk_weights)), 4)\n",
    "\n",
    "if eval_mode in ('static', 'both'):\n",
    "    val_pnl = simulate_stake_pnl(val_eval['numerai_era_corrs'], era_dates=val_era_dates)\n",
    "    val_dsr_info = compute_deflated_sharpe_ratio(val_eval['numerai_era_corrs'], [val_eval['numerai_sharpe']])\n",
    "    default_variant_name = f'{model_name} [Default]'\n",
    "    model_results[default_variant_name] = {\n",
    "        'variant': default_variant_name,\n",
    "        'score_version': str(score_version),\n",
    "        'train_corr': train_eval['numerai_corr'],\n",
    "        'validation_corr': val_eval['numerai_corr'],\n",
    "        'validation_corr_pct': val_eval['numerai_corr_pct'],\n",
    "        'positive_era_pct': val_eval['positive_era_pct'],\n",
    "        'era_consistency_pct': val_eval['era_consistency_pct'],\n",
    "        'directional_accuracy_pct': val_eval['directional_accuracy_pct'],\n",
    "        'validation_spearman': val_eval['spearman'],\n",
    "        'validation_payout': val_eval['payout'],\n",
    "        'validation_sharpe': val_eval['numerai_sharpe'],\n",
    "        'validation_lo_sharpe': val_eval['lo_sharpe'],\n",
    "        'validation_psr': round(float(val_dsr_info['psr']), 4),\n",
    "        'validation_dsr': round(float(val_dsr_info['dsr']), 4),\n",
    "        'effective_n_trials_onc': round(float(val_dsr_info['effective_n_trials']), 2),\n",
    "        'validation_fnc': val_eval['feature_neutral_corr'],\n",
    "        'validation_fnc_sharpe': val_eval['fnc_sharpe'],\n",
    "        'tuw_max_eras': val_eval['tuw_max_eras'],\n",
    "        'hhi_pos': val_eval['hhi_pos'],\n",
    "        'hhi_neg': val_eval['hhi_neg'],\n",
    "        'validation_spearman_sharpe': val_eval['spearman_sharpe'],\n",
    "        'validation_mae': val_eval['mae'],\n",
    "        'forecast_bias': val_eval['forecast_bias'],\n",
    "        'directional_hit_rate': val_eval['directional_hit_rate'],\n",
    "        'era_corr_lag1_acf': val_eval['era_corr_lag1_acf'],\n",
    "        'ljung_box_pvalue': val_eval['ljung_box_pvalue'],\n",
    "        'arch_lm_pvalue': val_eval['arch_lm_pvalue'],\n",
    "        'adf_pvalue': val_eval['adf_pvalue'],\n",
    "        'era_corr_skew': val_eval['era_corr_skew'],\n",
    "        'era_corr_kurtosis': val_eval['era_corr_kurtosis'],\n",
    "        'jarque_bera_pvalue': val_eval['jarque_bera_pvalue'],\n",
    "        'feature_exposure': val_eval['feature_exposure'],\n",
    "        'corr_drawdown': val_eval['corr_drawdown'],\n",
    "        'start_capital': round(float(val_pnl['start_capital']), 2),\n",
    "        'end_capital': round(float(val_pnl['end_capital']), 2),\n",
    "        'total_profit': round(float(val_pnl['total_profit']), 2),\n",
    "        'total_return_pct': round(float(val_pnl['total_return_pct']), 2),\n",
    "        'money_drawdown_pct': round(float(val_pnl['money_drawdown_pct']), 2),\n",
    "        'max_drawdown_gbp': round(float(val_pnl['max_drawdown_gbp']), 2),\n",
    "        'worst_round_gbp': round(float(val_pnl['worst_round_gbp']), 2),\n",
    "        'corr_gap': train_eval['numerai_corr'] - val_eval['numerai_corr'],\n",
    "        'sanity_status': val_eval['sanity_status'],\n",
    "        'validation_preds': val_preds,\n",
    "        'validation_era_corrs': val_eval['numerai_era_corrs'],\n",
    "        'params': default_params,\n",
    "    }\n",
    "\n",
    "tuned_val_eval = evaluate_numerai_predictions(\n",
    "    y_validation,\n",
    "    tuned_val_preds,\n",
    "    eras=validation_eras,\n",
    "    features_df=None,\n",
    "    feature_columns=feature_columns,\n",
    "    label=f'{model_name} [Tuned] — Final Validation Scores',\n",
    "    verbose=True,\n",
    ")\n",
    "tuned_val_eval['feature_exposure'] = round(float(np.average(_tun_fexp_vals, weights=_chunk_weights)), 4)\n",
    "eff_trial_srs = trial_srs if trial_srs is not None else np.array([tuned_val_eval['numerai_sharpe']], dtype=np.float64)\n",
    "\n",
    "if eval_mode in ('static', 'both'):\n",
    "    tuned_val_pnl = simulate_stake_pnl(tuned_val_eval['numerai_era_corrs'], era_dates=val_era_dates)\n",
    "    tuned_dsr_info = compute_deflated_sharpe_ratio(\n",
    "        tuned_val_eval['numerai_era_corrs'],\n",
    "        eff_trial_srs,\n",
    "        trials_matrix=trials_matrix,\n",
    "        random_state=random_state,\n",
    "    )\n",
    "    tuned_variant_name = f'{model_name} [Tuned]'\n",
    "    model_results[tuned_variant_name] = {\n",
    "        'variant': tuned_variant_name,\n",
    "        'score_version': effective_ver,\n",
    "        'train_corr': tuned_train_eval['numerai_corr'],\n",
    "        'validation_corr': tuned_val_eval['numerai_corr'],\n",
    "        'validation_corr_pct': tuned_val_eval['numerai_corr_pct'],\n",
    "        'positive_era_pct': tuned_val_eval['positive_era_pct'],\n",
    "        'era_consistency_pct': tuned_val_eval['era_consistency_pct'],\n",
    "        'directional_accuracy_pct': tuned_val_eval['directional_accuracy_pct'],\n",
    "        'validation_spearman': tuned_val_eval['spearman'],\n",
    "        'validation_payout': tuned_val_eval['payout'],\n",
    "        'validation_sharpe': tuned_val_eval['numerai_sharpe'],\n",
    "        'validation_lo_sharpe': tuned_val_eval['lo_sharpe'],\n",
    "        'validation_psr': round(float(tuned_dsr_info['psr']), 4),\n",
    "        'validation_dsr': round(float(tuned_dsr_info['dsr']), 4),\n",
    "        'effective_n_trials_onc': round(float(tuned_dsr_info['effective_n_trials']), 2),\n",
    "        'validation_fnc': tuned_val_eval['feature_neutral_corr'],\n",
    "        'validation_fnc_sharpe': tuned_val_eval['fnc_sharpe'],\n",
    "        'tuw_max_eras': tuned_val_eval['tuw_max_eras'],\n",
    "        'hhi_pos': tuned_val_eval['hhi_pos'],\n",
    "        'hhi_neg': tuned_val_eval['hhi_neg'],\n",
    "        'validation_spearman_sharpe': tuned_val_eval['spearman_sharpe'],\n",
    "        'validation_mae': tuned_val_eval['mae'],\n",
    "        'forecast_bias': tuned_val_eval['forecast_bias'],\n",
    "        'directional_hit_rate': tuned_val_eval['directional_hit_rate'],\n",
    "        'era_corr_lag1_acf': tuned_val_eval['era_corr_lag1_acf'],\n",
    "        'ljung_box_pvalue': tuned_val_eval['ljung_box_pvalue'],\n",
    "        'arch_lm_pvalue': tuned_val_eval['arch_lm_pvalue'],\n",
    "        'adf_pvalue': tuned_val_eval['adf_pvalue'],\n",
    "        'era_corr_skew': tuned_val_eval['era_corr_skew'],\n",
    "        'era_corr_kurtosis': tuned_val_eval['era_corr_kurtosis'],\n",
    "        'jarque_bera_pvalue': tuned_val_eval['jarque_bera_pvalue'],\n",
    "        'feature_exposure': tuned_val_eval['feature_exposure'],\n",
    "        'corr_drawdown': tuned_val_eval['corr_drawdown'],\n",
    "        'start_capital': round(float(tuned_val_pnl['start_capital']), 2),\n",
    "        'end_capital': round(float(tuned_val_pnl['end_capital']), 2),\n",
    "        'total_profit': round(float(tuned_val_pnl['total_profit']), 2),\n",
    "        'total_return_pct': round(float(tuned_val_pnl['total_return_pct']), 2),\n",
    "        'money_drawdown_pct': round(float(tuned_val_pnl['money_drawdown_pct']), 2),\n",
    "        'max_drawdown_gbp': round(float(tuned_val_pnl['max_drawdown_gbp']), 2),\n",
    "        'worst_round_gbp': round(float(tuned_val_pnl['worst_round_gbp']), 2),\n",
    "        'corr_gap': tuned_train_eval['numerai_corr'] - tuned_val_eval['numerai_corr'],\n",
    "        'sanity_status': tuned_val_eval['sanity_status'],\n",
    "        'validation_preds': tuned_val_preds,\n",
    "        'validation_era_corrs': tuned_val_eval['numerai_era_corrs'],\n",
    "        'params': tuned_params,\n",
    "    }\n",
    "\n",
    "if eval_mode in ('walk_forward', 'both'):\n",
    "    # Reload cached train from processed_cache only for parallel chunked walk-forward refits\n",
    "    train_df, _, _, _ = load_unity_numerai_data_cached(\n",
    "        data_version=data_version, data_folder=data_folder, kaggle_dataset=kaggle_dataset,\n",
    "        feature_set=feature_set, target_col=TARGET_COL, era_stride=era_stride,\n",
    "        downsample_mode=downsample_mode, downsample_frac=downsample_frac,\n",
    "        val_downsample_mode=val_downsample_mode, val_downsample_frac=val_downsample_frac,\n",
    "        random_state=random_state, ticker_timeseries_features=ticker_timeseries_features,\n",
    "        ticker_rolling_windows=ticker_rolling_windows, ticker_lag_steps=ticker_lag_steps,\n",
    "        workspace_root=workspace_root, auto_download=True, use_numerapi_fallback=True,\n",
    "        force_reload=False, split='train',\n",
    "    )\n",
    "    X_train = train_df[[c for c in val_input_columns if c in train_df.columns]].reset_index(drop=True)\n",
    "    y_train = train_df[TARGET_COL].astype(np.float32).reset_index(drop=True)\n",
    "    train_eras = train_df[ERA_COL].astype(np.int32).reset_index(drop=True)\n",
    "    del train_df\n",
    "    gc.collect()\n",
    "\n",
    "    tuned_wf_preds = walk_forward_predict(\n",
    "        tuned_pipeline,\n",
    "        X_train,\n",
    "        y_train,\n",
    "        train_eras,\n",
