    "downsample_mode = 'recent'  # None, 'recent', 'earliest', or 'uniform'\n",
    "downsample_frac = 1.0          # Fraction of strided training data to keep in (0.0, 1.0]\n",
    "val_downsample_mode = 'recent'     # Validation: None (100%), 'same', 'recent', 'earliest', or 'uniform'\n",
    "val_downsample_frac = 1.0             # Fraction of validation data to keep in (0.0, 1.0] (None mirrors downsample_frac)\n",
    "n_iter = 37\n",
    "n_jobs = -1                    # LightGBM thread count (inner CV stays 1 to avoid RAM duplication)\n",
    "save_results = True\n",
    "save_plots = False             # Save PNG plots to workspace (CSV/JSON still controlled by save_results)\n",
    "memory_guard_enabled = True    # Explicit RAM fail-safe: set False to switch off\n",
