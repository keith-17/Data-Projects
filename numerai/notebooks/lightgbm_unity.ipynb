"        .replace(' ', '_')\n","        .replace('[', '')\n","        .replace(']', '')\n","        .replace('-', '_')\n","    )\n","    variant_era_corrs = model_results[variant_name]['validation_era_corrs']\n","    variant_era_contrib = compute_per_era_mmc(\n","        val_mmc_df,\n","        model_results[variant_name]['validation_preds'],\n","        meta_model_path=v6_contrib_info['meta_model_path'],\n","        benchmark_path=v6_contrib_info['benchmark_path'],\n","        is_benchmark_proxy=staking_is_proxy,\n","        era_col=ERA_COL,\n","        target_col=TARGET_COL,\n","    )\n","    variant_era_mmc_by_variant[variant_name] = variant_era_contrib\n","\n","    live_scenarios_by_variant[variant_name] = simulate_live_staking_scenarios(\n","        variant_era_corrs,\n","        per_era_mmc=variant_era_contrib,\n","        mmc_is_proxy=staking_is_proxy,\n","        total_capital=1000.0,\n","        settlement_rounds=12,\n","        weekly_concurrent_rounds=12,\n","        conservative_payout_factor=0.5,\n","        live_payout_factor=0.5,\n","        bmc_proxy_haircut=0.5,\n","        n_sims=500,\n","        block_size=12,\n","        random_state=random_state,\n","        title=variant_name,\n","        era_dates=val_era_dates,\n","    )\n","\n","    title_label = f'[CV-LOCKED WINNER] {variant_name}' if is_best_variant else variant_name\n","    pnl_save_path = (\n","        results_dir / f'{timestamp}_{experiment_name}_{variant_slug}_stake_pnl_dashboard.png'\n","        if save_results\n","        else None\n","    )\n","    haircutted_contrib = (\n","        pd.Series(variant_era_contrib, dtype=np.float64) * (0.5 if staking_is_proxy else 1.0)\n","        if variant_era_contrib is not None\n","        else None\n","    )\n","    if haircutted_contrib is not None:\n","        haircutted_contrib.name = 'bmc_proxy' if staking_is_proxy else 'mmc'\n","    stake_pnl_by_variant[variant_name] = plot_stake_pnl_dashboard(\n","        variant_era_corrs,\n","        per_era_mmc=haircutted_contrib,\n","        mmc_is_proxy=staking_is_proxy,\n","        conservative_pnl=live_scenarios_by_variant[variant_name]['conservative_floor']['pnl'],\n","        title=f'{title_label} [Realistic Live vs Conservative Floor | PF=0.5, R=12]',\n","        total_capital=1000.0,\n","        concurrent_rounds=12,\n","        settlement_rounds=12,\n","        payout_factor=0.5,\n","        payout_rule='auto',\n","        staking_mode='compound',\n","        era_dates=val_era_dates,\n","        save_path=pnl_save_path,\n","    )\n","\n","    v_pnl = stake_pnl_by_variant[variant_name]\n","    c_pnl = live_scenarios_by_variant[variant_name]['conservative_floor']['pnl']\n","    mean_contrib = float(variant_era_contrib.mean()) if variant_era_contrib is not None and len(variant_era_contrib) > 0 else np.nan\n","    contrib_col_name = 'validation_bmc_proxy' if staking_is_proxy else 'validation_true_mmc'\n","    staking_summary_rows.append({\n","        'variant': variant_name,\n","        'staking_basis': v_pnl['score_basis'],\n","        'staking_mode': 'One-Wallet (Compounding, PF=0.5, R=12)',\n","        'validation_corr': round(float(variant_era_corrs.mean()), 4),\n","        contrib_col_name: round(mean_contrib, 4) if np.isfinite(mean_contrib) else np.nan,\n","        'start_capital': round(float(v_pnl['start_capital']), 2),\n","        'end_capital': round(float(v_pnl['end_capital']), 2),\n","        'total_return_pct': round(float(v_pnl['total_return_pct']), 2),\n","        'worst_dip_pct': round(float(v_pnl['money_drawdown_pct']), 2),\n","        'worst_dip_gbp': round(float(v_pnl['max_drawdown_gbp']), 2),\n","        'worst_round_gbp': round(float(v_pnl['worst_round_gbp']), 2),\n","    })\n","    print(\n","        f\"{title_label} | Realistic Live (PF=0.5, 0.5x BMC, R=12): £{v_pnl['end_capital']:,.2f} ({v_pnl['total_return_pct']:+.2f}%, Dip {v_pnl['money_drawdown_pct']:.2f}%) | \"\n","        f\"Conservative Floor (CORR only, PF=0.5, R=12): £{c_pnl['end_capital']:,.2f} ({c_pnl['total_return_pct']:+.2f}%, Dip {c_pnl['money_drawdown_pct']:.2f}%) | \"\n","        f\"Basis: {v_pnl['score_basis']}\"\n","    )\n","\n","staking_comparison_df = pd.DataFrame(staking_summary_rows)\n","live_staking_scenarios_df = build_live_staking_scenarios_df(live_scenarios_by_variant)\n","comparison_df['staking_basis'] = comparison_df['variant'].map(\n","    staking_comparison_df.set_index('variant')['staking_basis']\n",")\n","if staking_is_proxy:\n","    comparison_df['validation_bmc_proxy'] = comparison_df['variant'].map(\n","        staking_comparison_df.set_index('variant')['validation_bmc_proxy']\n","    )\n","elif v6_contrib_info['basis_kind'] == 'true_mmc':\n","    comparison_df['validation_true_mmc'] = comparison_df['variant'].map(\n","        staking_comparison_df.set_index('variant')['validation_true_mmc']\n","    )\n","print('\\nDual-Scenario Realistic Live Staking Table (Conservative Floor [CORR only, PF=0.5, R=12] vs Realistic Live [CORR + 0.5x BMC proxy, PF=0.5, R=12]):')\n","display(live_staking_scenarios_df)\n","best_stake_pnl = stake_pnl_by_variant[best_variant_name]"]},{"cell_type":"markdown","id":"6c05b302","metadata":{"papermill":{"duration":0.035091,"end_time":"2026-11-25T04:46:35.521511+00:00","exception":false,"start_time":"2026-11-25T04:46:35.48642+00:00","status":"completed"},"tags":[]},"source":["## Monte Carlo Block-Bootstrap Risk Analysis (£)"]},{"cell_type":"code","execution_count":22,"id":"660af9b5","metadata":{"execution":{"iopub.execute_input":"2026-11-25T04:46:35.594271Z","iopub.status.busy":"2026-11-25T04:46:35.593883Z","iopub.status.idle":"2026-11-25T04:46:51.588753Z","shell.execute_reply":"2026-11-25T04:46:51.587708Z"},"papermill":{"duration":16.045045,"end_time":"2026-11-25T04:46:51.601612+00:00","exception":false,"start_time":"2026-11-25T04:46:35.556567+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1650x1140 with 3 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["====================================================================================================\n","LightGBM Regressor [Walk-Forward] — VERDICT: Median path MAKES money. Median finish £2,828.02 from £1,000 start (+182.8%). 88.4% of 500 simulated paths finish above £1,000 (11.6% lose money).\n","\n","How to read Drawdown vs Final Balance (Plain English):\n","  • Drawdown is the biggest peak-to-trough dip DURING the journey — NOT your final profit or loss.\n","  • Worked example (Winning path with a drawdown): Start £1,000 -> rises to £1,200 peak -> dips to £1,100 (-8.3% drawdown from peak) -> recovers to £1,300. You still finish +£300 ABOVE £1,000 despite the dip.\n","  • Worked example (Losing path with a small drawdown): Start £1,000 -> drifts down to £955 (-4.5% dip) and ends at £984.81. A small drawdown still finishes BELOW £1,000 if it never recovers.\n","  • Median (50th) vs 95th percentile are DIFFERENT paths: Median = typical path; 95th = lucky top 5% of paths.\n","  • One-Wallet MC: Simulates ONE continuous wallet from start to finish over the full validation period with no resets.\n","  • Within-Window MC: Simulates separate, reset windows (e.g. rolling sub-period pots) — a different test that is never mixed with One-Wallet MC.\n","  • Sizing rule in this One-Wallet run: Compounding. Compounding resizes each round's stake as your wallet grows, so a path can climb very high, suffer a huge peak-to-trough drawdown (e.g. -91.8% from a high peak), and STILL finish above £1,000.\n","\n","LightGBM Regressor [Walk-Forward] [Realistic Live: PF=0.5, 0.5x BMC, R=12] [One-Wallet MC | BMC proxy (benchmark, NOT true MMC) | Compounding] | P(Profit): 88.4% (11.6% lose) | Median (50th): £2,828.02 (+182.8%) | 5th Pct: £555.57 | 95th Pct: £11,582.18 | 95% Worst Dip: -75.81% | P(Ruin): 0.0%\n","  -> What drawdown means: 95% Worst Dip -75.81% means in 95% of paths the worst fall from peak was 75.81% or less — this is NOT the final loss.\n","  -> Conservative Floor MC (CORR only, PF=0.5, R=12): P(Profit)=97.6% | Median=£1,915.38 | 95% Worst Dip=-30.02%\n","====================================================================================================\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1650x1140 with 3 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["====================================================================================================\n","LightGBM Regressor [Default] — VERDICT: Median path MAKES money. Median finish £1,441.52 from £1,000 start (+44.2%). 62.2% of 500 simulated paths finish above £1,000 (37.8% lose money).\n","\n","LightGBM Regressor [Default] [Realistic Live: PF=0.5, 0.5x BMC, R=12] [One-Wallet MC | BMC proxy (benchmark, NOT true MMC) | Compounding] | P(Profit): 62.2% (37.8% lose) | Median (50th): £1,441.52 (+44.2%) | 5th Pct: £246.85 | 95th Pct: £8,194.66 | 95% Worst Dip: -85.31% | P(Ruin): 0.0%\n","  -> What drawdown means: 95% Worst Dip -85.31% means in 95% of paths the worst fall from peak was 85.31% or less — this is NOT the final loss.\n","  -> Conservative Floor MC (CORR only, PF=0.5, R=12): P(Profit)=80.6% | Median=£1,413.52 | 95% Worst Dip=-43.13%\n","====================================================================================================\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1650x1140 with 3 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["====================================================================================================\n","[CV-LOCKED WINNER] LightGBM Regressor [Tuned] — VERDICT: Median path LOSES money. Median finish £319.56 from £1,000 start (-68.0%). Only 11.0% of 500 simulated paths finish above £1,000 (89.0% lose money). This model is NOT profitable on average in simulation.\n","\n","[CV-LOCKED WINNER] LightGBM Regressor [Tuned] [Realistic Live: PF=0.5, 0.5x BMC, R=12] [One-Wallet MC | BMC proxy (benchmark, NOT true MMC) | Compounding] | P(Profit): 11.0% (89.0% lose) | Median (50th): £319.56 (-68.0%) | 5th Pct: £70.59 | 95th Pct: £1,284.07 | 95% Worst Dip: -95.20% | P(Ruin): 0.0%\n","  -> What drawdown means: 95% Worst Dip -95.20% means in 95% of paths the worst fall from peak was 95.20% or less — this is NOT the final loss.\n","  -> Conservative Floor MC (CORR only, PF=0.5, R=12): P(Profit)=16.4% | Median=£746.98 | 95% Worst Dip=-60.12%\n","====================================================================================================\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1650x1140 with 3 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["====================================================================================================\n","LightGBM Regressor [Tuned Walk-Forward] — VERDICT: Median path LOSES money. Median finish £137.40 from £1,000 start (-86.3%). Only 2.2% of 500 simulated paths finish above £1,000 (97.8% lose money). This model is NOT profitable on average in simulation.\n","\n","LightGBM Regressor [Tuned Walk-Forward] [Realistic Live: PF=0.5, 0.5x BMC, R=12] [One-Wallet MC | BMC proxy (benchmark, NOT true MMC) | Compounding] | P(Profit): 2.2% (97.8% lose) | Median (50th): £137.40 (-86.3%) | 5th Pct: £20.90 | 95th Pct: £709.63 | 95% Worst Dip: -98.27% | P(Ruin): 0.0%\n","  -> What drawdown means: 95% Worst Dip -98.27% means in 95% of paths the worst fall from peak was 98.27% or less — this is NOT the final loss.\n","  -> Conservative Floor MC (CORR only, PF=0.5, R=12): P(Profit)=6.8% | Median=£628.78 | 95% Worst Dip=-68.38%\n","====================================================================================================\n"]}],"source":["mc_risk_by_variant = {}\n","explainer_printed = False\n","staking_is_proxy = bool(v6_contrib_info['mmc_is_proxy'])\n","for variant_name in comparison_df['var