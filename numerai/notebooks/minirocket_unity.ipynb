    "    save_results=save_results,\n",
    "    memory_guard_enabled=memory_guard_enabled,\n",
    "    memory_guard_min_free_gb=memory_guard_min_free_gb,\n",
    "    error_bin_mode=error_bin_mode,\n",
    "    workspace_root=workspace_root,\n",
    "    wandb_project='numerai-minirocket',\n",
    ")\n",
    "globals().update(setup_cfg)\n"
