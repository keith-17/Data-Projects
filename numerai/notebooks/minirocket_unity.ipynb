']\n","staking_is_proxy = bool(v6_contrib_info['mmc_is_proxy'])\n","print(f\"Active Staking Basis: {staking_basis_label}\")\n","print(f\"  -> Reason: {v6_contrib_info['reason']}\")\n","\n","stake_pnl_by_variant = {}\n","variant_era_mmc_by_variant = {}\n","live_scenarios_by_variant = {}\n","staking_summary_rows = []\n","for variant_name in comparison_df['variant'].tolist():\n","    is_best_variant = (variant_name == best_variant_name)\n","    variant_slug = (\n","        variant_name.lower()\n","        .replace(' ', '_')\n","        .replace('(', '')\n","        .replace(')', '')\n","        .replace('[', '')\n","        .replace(']', '')\n","        .replace('-', '_')\n","    )\n","    variant_era_corrs = model_results[variant_name]['validation_era_corrs']\n","    variant_era_contrib = compute_per_era_mmc(\n","        val_mmc_df,\n","        model_results[variant_name]['validation_preds'],\n","        meta_model_path=v6_contrib_info['meta_model_path'],\n","        benchmark_path=v6_contrib_info['benchmark_path'],\n","        is_benchmark_proxy=staking_is_proxy,\n","        era_col=ERA_COL,\n","        target_col=TARGET_COL,\n","    )\n","    variant_era_mmc_by_variant[variant_name] = variant_era_contrib\n","\n","    live_scenarios_by_variant[variant_name] = simulate_live_staking_scenarios(\n","        variant_era_corrs,\n","        per_era_mmc=variant_era_contrib,\n","        mmc_is_proxy=staking_is_proxy,\n","        total_capital=1000.0,\n","        settlement_rounds=12,\n","        weekly_concurrent_rounds=12,\n","        conservative_payout_factor=0.5,\n","        live_payout_factor=0.5,\n","        bmc_proxy_haircut=0.5,\n","        n_sims=500,\n","        block_size=12,\n","        random_state=random_state,\n","        title=variant_name,\n","        era_dates=val_era_dates,\n","    )\n","\n","    title_label = f'[CV-LOCKED WINNER] {variant_name}' if is_best_variant else variant_name\n","    pnl_save_path = (\n","        results_dir / f'{timestamp}_{experiment_name}_{variant_slug}_stake_pnl_dashboard.png'\n","        if save_results\n","        else None\n","    )\n","    haircutted_contrib = (\n","        pd.Series(variant_era_contrib, dtype=np.float64) * (0.5 if staking_is_proxy else 1.0)\n","        if variant_era_contrib is not None\n","        else None\n","    )\n","    if haircutted_contrib is not None:\n","        haircutted_contrib.name = 'bmc_proxy' if staking_is_proxy else 'mmc'\n","    stake_pnl_by_variant[variant_name] = plot_stake_pnl_dashboard(\n","        variant_era_corrs,\n","        per_era_mmc=haircutted_contrib,\n","        mmc_is_proxy=staking_is_proxy,\n","        conservative_pnl=live_scenarios_by_variant[variant_name]['conservative_floor']['pnl'],\n","        title=f'{title_label} [Realistic Live vs Conservative Floor | PF=0.5, R=12]',\n","        total_capital=1000.0,\n","        concurrent_rounds=12,\n","        settlement_rounds=12,\n","        payout_factor=0.5,\n","        payout_rule='auto',\n","        staking_mode='compound',\n","        era_dates=val_era_dates,\n","        save_path=pnl_save_path,\n","    )\n","\n","    v_pnl = stake_pnl_by_variant[variant_name]\n","    c_pnl = live_scenarios_by_variant[variant_name]['conservative_floor']['pnl']\n","    mean_contrib = float(variant_era_contrib.mean()) if variant_era_contrib is not None and len(variant_era_contrib) > 0 else np.nan\n","    contrib_col_name = 'validation_bmc_proxy' if staking_is_proxy else 'validation_true_mmc'\n","    staking_summary_rows.append({\n","        'variant': variant_name,\n","        'staking_basis': v_pnl['score_basis'],\n","        'staking_mode': 'One-Wallet (Compounding, PF=0.5, R=12)',\n","        'validation_corr': round(float(variant_era_corrs.mean()), 4),\n","        contrib_col_name: round(mean_contrib, 4) if np.isfinite(mean_contrib) else np.nan,\n","        'start_capital': round(float(v_pnl['start_capital']), 2),\n","        'end_capital': round(float(v_pnl['end_capital']), 2),\n","        'total_return_pct': round(float(v_pnl['total_return_pct']), 2),\n","        'worst_dip_pct': round(float(v_pnl['money_drawdown_pct']), 2),\n","        'worst_dip_gbp': round(float(v_pnl['max_drawdown_gbp']), 2),\n","        'worst_round_gbp': round(float(v_pnl['worst_round_gbp']), 2),\n","    })\n","    print(\n","        f\"{title_label} | Realistic Live (PF=0.5, 0.5x BMC, R=12): £{v_pnl['end_capital']:,.2f} ({v_pnl['total_return_pct']:+.2f}%, Dip {v_pnl['money_drawdown_pct']:.2f}%) | \"\n","        f\"Conservative Floor (CORR only, PF=0.5, R=12): £{c_pnl['end_capital']:,.2f} ({c_pnl['total_return_pct']:+.2f}%, Dip {c_pnl['money_drawdown_pct']:.2f}%) | \"\n","        f\"Basis: {v_pnl['score_basis']}\"\n","    )\n","\n","staking_comparison_df = pd.DataFrame(staking_summary_rows)\n","live_staking_scenarios_df = build_live_staking_scenarios_df(live_scenarios_by_variant)\n","comparison_df['staking_basis'] = comparison_df['variant'].map(\n","    staking_comparison_df.set_index('variant')['staking_basis']\n",")\n","if staking_is_proxy:\n","    comparison_df['validation_bmc_proxy'] = comparison_df['variant'].map(\n","        staking_comparison_df.set_index('variant')['validation_bmc_proxy']\n","    )\n","elif v6_contrib_info['basis_kind'] == 'true_mmc':\n","    comparison_df['validation_true_mmc'] = comparison_df['variant'].map(\n","        staking_comparison_df.set_index('variant')['validation_true_mmc']\n","    )\n","display_compact_dataframe(\n","    live_staking_scenarios_df,\n","    title='Dual-Scenario Realistic Live Staking Table (Conservative Floor vs. Realistic Live):',\n",")\n","best_stake_pnl = stake_pnl_by_variant[best_variant_name]\n","del val_mmc_df, val_diag_meta\n","gc.collect()"]},{"cell_type":"markdown","id":"dd52a1c6","metadata":{"papermill":{"duration":0.017891,"end_time":"2026-11-25T23:30:39.392465+00:00","exception":false,"start_time":"2026-11-25T23:30:39.374574+00:00","status":"completed"},"tags":[]},"source":["### Monte Carlo Block-Bootstrap Risk Analysis (£)"]},{"cell_type":"code","execution_count":18,"id":"41ec9433","metadata":{"execution":{"iopub.execute_input":"2026-11-25T23:30:39.433126Z","iopub.status.busy":"2026-11-25T23:30:39.432481Z","iopub.status.idle":"2026-11-25T23:30:56.957589Z","shell.execute_reply":"2026-11-25T23:30:56.956308Z"},"papermill":{"duration":17.556005,"end_time":"2026-11-25T23:30:56.967494+00:00","exception":false,"start_time":"2026-11-25T23:30:39.411489+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1650x1140 with 3 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["====================================================================================================\n","MiniRocket Regressor [Default] — VERDICT: Median path MAKES money. Median finish £2,083.70 from £1,000 start (+108.4%). 99.4% of 500 simulated paths finish above £1,000 (0.6% lose money).\n","\n","How to read Drawdown vs Final Balance (Plain English):\n","  • Drawdown is the biggest peak-to-trough dip DURING the journey — NOT your final profit or loss.\n","  • Worked example (Winning path with a drawdown): Start £1,000 -> rises to £1,200 peak -> dips to £1,100 (-8.3% drawdown from peak) -> recovers to £1,300. You still finish +£300 ABOVE £1,000 despite the dip.\n","  • Worked example (Losing path with a small drawdown): Start £1,000 -> drifts down to £955 (-4.5% dip) and ends at £984.81. A small drawdown still finishes BELOW £1,000 if it never recovers.\n","  • Median (50th) vs 95th percentile are DIFFERENT paths: Median = typical path; 95th = lucky top 5% of paths.\n","  • One-Wallet MC: Simulates ONE continuous wallet from start to finish over the full validation period with no resets.\n","  • Within-Window MC: Simulates separate, reset windows (e.g. rolling sub-period pots) — a different test that is never mixed with One-Wallet MC.\n","  • Sizing rule in this One-Wallet run: Compounding. Compounding resizes each round's stake as your wallet grows, so a path can climb very high, suffer a huge peak-to-trough drawdown (e.g. -91.8% from a high peak), and STILL finish above £1,000.\n","\n","MiniRocket Regressor [Default] [Realistic Live: PF=0.5, 0.5x BMC, R=12] [One-Wallet MC | BMC proxy (benchmark, NOT true MMC) | Compounding] | P(Profit): 99.4% (0.6% lose) | Median (50th): £2,083.70 (+108.4%) | 5th Pct: £1,294.06 | 95th Pct: £3,028.45 | 95% Worst Dip: -22.94% | P(Ruin): 0.0%\n","  -> What drawdown means: 95% Worst Dip -22.94% means in 95% of paths the worst fall from peak was 22.94% or less — this is NOT the final loss.\n","  -> Conservative Floor MC (CORR only, PF=0.5, R=12): P(Profit)=100.0% | Median=£1,495.11 | 95% Worst Dip=-5.41%\n","====================================================================================================\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1650x1140 with 3 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["====================================================================================================\n","MiniRocket Regressor [Walk-Forward] — VERDICT: Median path MAKES money. Median finish £1,475.98 from £1,000 start (+47.6%). 95.8% of 500 simulated paths finish above £1,000 (4.2% lose money).\n","\n","MiniRocket Regressor [Walk-Forward] [Realistic Live: PF=0.5, 0.5x BMC, R=12] [One-Wallet MC | BMC proxy (benchmark, NOT true MMC) | Compounding] | P(Profit): 95.8% (4.2% lose) | Median (50th): £1,475.98 (+47.6%) | 5th Pct: £1,027.53 | 95th Pct: £2,091.41 | 95% Worst Dip: -23.72% | P(Ruin): 0.0%\n","  -> What drawdown means: 95% Worst Dip -23.72% means in 95% of paths the worst fall from peak was 23.72% or less — this is NOT the final loss.\n","  -> Conservative Floor MC (CORR only, PF=0.5, R=12): P(Profit)=100.0% | Median=£1,344.35 | 95% Worst Dip=-4.34%\n","====================================================================================================\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1650x1140 with 3 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["====================================================================================================\n","MiniRocket Regressor [Tuned Walk-Forward] — VERDICT: Median path LOSES money. Median finish £971.04 from £1,000 start (-2.9%). Only 45.8% of 500 simulated paths finish above £1,000 (54.2% lose money). This model is NOT profitable on average in simulation.\n","\n","MiniRocket Regressor [Tuned Walk-Forward] [Realistic Live: PF=0.5, 0.5x BMC, R=12] [One-Wallet MC | BMC proxy (benchmark, NOT true MMC) | Compounding] | P(Profit): 45.8% (54.2% lose) | Median (50th): £971.04 (-2.9%) | 5th Pct: £698.07 | 95th Pct: £1,351.46 | 95% Worst Dip: -36.60% | P(Ruin): 0.0%\n","  -> What drawdown means: 95% Worst Dip -36.60% means in 95% of paths the worst fall from peak was 36.60% or less — this is NOT the final loss.\n","  -> Conservative Floor MC (CORR only, PF=0.5, R=12): P(Profit)=85.2% | Median=£1,072.48 | 95% Worst Dip=-8.90%\n","====================================================================================================\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1650x1140 with 3 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["====================================================================================================\n","[CV-LOCKED WINNER] MiniRocket Regressor [Tuned] — VERDICT: Median path MAKES money. Median finish £1,025.86 from £1,000 start (+2.6%). 54.8% of 500 simulated paths finish above £1,000 (45.2% lose money).\n","\n","[CV-LOCKED WINNER] MiniRocket Regressor [Tuned] [Realistic Live: PF=0.5, 0.5x BMC, R=12] [One-Wallet MC | BMC proxy (benchmark, NOT true MMC) | Compounding] | P(Profit): 54.8% (45.2% lose) | Median (50th): £1,025.86 (+2.6%) | 5th Pct: £682.47 | 95th Pct: £1,507.49 | 95% Worst Dip: -40.07% | P(Ruin): 0.0%\n","  -> What drawdown means: 95% Worst Dip -40.07% means in 95% of paths the worst fall from peak was 40.07% or less — this is NOT the final loss.\n","  -> Conservative Floor MC (CORR only, PF=0.5, R=12): P(Profit)=81.0% | Median=£1,070.10 | 95% Worst Dip=-11.04%\n","====================================================================================================\n"]},{"data":{"text/plain":["46938"]},"execution_count":18,"metadata":{},"output_type":"execute_result"}],"source":["mc_risk_by_variant = {}\n","explainer_printed = False\n","staking_is_proxy = bool(v6_contrib_info['mmc_is_proxy'])\n","for variant_name in comparison_df['variant'].tolist():\n","    is_best_variant = (variant_name == best_variant_name)\n","    variant_slug = (\n","        variant_name.lower()\n","        .replace(' ', '_')\n","        .replace('(', '')\n","        .replace(')', '')\n","        .replace('[', '')\n","        .replace(']', '')\n","        .replace('-', '_')\n","    )\n","    mc_save_path = (\n","        results_dir / f'{timestamp}_{experiment_name}_{variant_slug}_monte_carlo_pnl.png'\n","        if save_results\n","        else None\n","    )\n","    title_label = f'[CV-LOCKED WINNER] {variant_name}' if is_best_variant else variant_name\n","    raw_contrib = variant_era_mmc_by_variant.get(variant_name)\n","    haircutted_contrib = (\n","        pd.Series(raw_contrib, dtype=np.float64) * (0.5 if staking_is_proxy else 1.0)\n","        if raw_contrib is not None\n","        else None\n","    )\n","    if haircutted_contrib is not None:\n","        haircutted_contrib.name = 'bmc_proxy' if staking_is_proxy else 'mmc'\n","    v_mc = plot_stake_pnl_monte_carlo(\n","        model_results[variant_name]['validation_era_corrs'],\n","        per_era_mmc=haircutted_contrib,\n","        mmc_is_proxy=staking_is_proxy,\n","        title=f'{title_label} [Realistic Live: PF=0.5, 0.5x BMC, R=12]',\n","        total_capital=1000.0,\n","        concurrent_rounds=12,\n","        settlement_rounds=12,\n","        payout_factor=0.5,\n","        payout_rule='auto',\n","        staking_mode='compound',\n","        n_sims=500,\n","        block_size=12,\n","        random_state=random_state,\n","        era_dates=val_era_dates,\n","        save_path=mc_save_path,\n","        retain_paths=False,\n","    )\n","    mc_risk_by_variant[variant_name] = v_mc\n","    c_mc = live_scenarios_by_variant[variant_name]['conservative_floor']['mc']\n","    print('=' * 100)\n","    print(f\"{title_label} — {v_mc['mc_verdict_text']}\")\n","    if not explainer_printed:\n","        print()\n","        print(v_mc['mc_explainer_text'])\n","        explainer_printed = True\n","    print()\n","    print(v_mc['mc_summary_line'])\n","    print(f\"  -> {v_mc['mc_drawdown_explanation_line']}\")\n","    print(\n","        f\"  -> Conservative Floor MC (CORR only, PF=0.5, R=12): P(Profit)={c_mc['mc_prob_profit_pct']:.1f}% | \"\n","        f\"Median=£{c_mc['mc_median_final_stake']:,.2f} | 95% Worst Dip={c_mc['mc_p95_money_drawdown_pct']:.2f}%\"\n","    )\n","    print('=' * 100)\n","gc.collect()"]},{"cell_type":"markdown","id":"1cafd358","metadata":{"papermill":{"duration":0.04445,"end_time":"2026-11-25T23:30:57.060273+00:00","exception":false,"start_time":"2026-11-25T23:30:57.015823+00:00","status":"completed"},"tags":[]},"source":["### Cumulative & Rolling 20-Era Validation CORR"]},{"cell_type":"code","execution_count":19,"id":"9adb0b61","metadata":{"execution":{"iopub.execute_input":"2026-11-25T23:30:57.148409Z","iopub.status.busy":"2026-11-25T23:30:57.14807Z","iopub.status.idle":"2026-11-25T23:30:58.189794Z","shell.execute_reply":"2026-11-25T23:30:58.18841Z"},"papermill":{"duration":1.088745,"end_time":"2026-11-25T23:30:58.193427+00:00","exception":false,"start_time":"2026-11-25T23:30:57.104682+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1450x520 with 1 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/pn