    "# --- Experiment Knobs (only things you actually change) ---\n",
    "TARGET_COL = 'target'          # Training target (auto-sets horizon & embargo)\n",
    "feature_set = 'all'          # 'small', 'medium', or 'all'\n",
    "era_stride = 'auto'            # 'auto' (matches target horizon: 12 for 60d, 4 for 20d) or explicit int (1, 2, 4, 12)\n",
    "\n",
    "search_mode = 'bayes'          # 'grid' or 'bayes'\n",
    "score_version = 'v1_skepta'    # 'v0_default', 'v1_skepta', or 'v2_skepta_mmc'\n",
    "eval_mode = 'both'             # 'static', 'walk_forward', or 'both'\n",
    "cv_strategy = 'timeseries'   # 'timeseries', 'purged_kfold' (AFML Ch. 7), or 'cpcv' (AFML Ch. 12)\n",
    "n_splits = 1\n",
    "cv_split = 0.8                 # Chronological CV train/test split ratio (used when n_splits == 1)\n",
    "downsample_mode = 'recent'         # None, 'recent', 'earliest', or 'uniform'\n",
    "downsample_frac = 0.25          # Fraction of strided training data to keep in (0.0, 1.0]\n",
    "val_downsample_mode = 'recent'     # Validation: None (100%), 'same', 'recent', 'earliest', or 'uniform'\n",
    "val_downsample_frac = 0.25             # Fraction of validation data to keep in (0.0, 1.0] (None mirrors downsample_frac)\n",
    "n_iter = 1\n",
    "n_jobs = -1                    # Worker thread count (inner CV stays 1 to avoid RAM duplication)\n",
    "save_results = True\n",
    "memory_guard_enabled = True    # Explicit RAM fail-safe: set False to switch off\n",
    "memory_guard_min_free_gb = 3.0 # Keep >=3 GB free RAM or fail candidate with error_score=-1.0\n",
    "error_bin_mode = 'pct'         # 'pct' (% error + zero-target tol) or 'abs' (raw residual bins)\n",
    "\n",
    "setup_cfg = build_experiment_setup(\n",
    "    target_col=TARGET_COL,\n",
    "    feature_set=feature_set,\n",
    "    era_stride=era_stride,\n",
    "    model_tag='minirocket',\n",
    "    search_mode=search_mode,\n",
    "    score_version=score_version,\n",
    "    eval_mode=eval_mode,\n",
    "    cv_strategy=cv_strategy,\n",
    "    n_splits=n_splits,\n",
    "    cv_split=cv_split,\n",
